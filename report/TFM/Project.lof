\contentsline {subfigure}{\numberline {(b)}{\ignorespaces {Subsampling using furthest point, some points corresponding to solid cells lie outside of the terrain}}}{34}{figure.caption.37}%
\contentsline {figure}{\numberline {4.10}{\ignorespaces Results of the furthest point sampling. Some artifacts arise due to cells outside of the terrain being marked as solid}}{34}{figure.caption.38}%
\contentsline {subfigure}{\numberline {(a)}{\ignorespaces {Decomposition results using the base sampling}}}{34}{figure.caption.38}%
\contentsline {subfigure}{\numberline {(b)}{\ignorespaces {Low-resolution decomposition using furthest point to collect a subsample }}}{34}{figure.caption.38}%
\contentsline {figure}{\numberline {4.11}{\ignorespaces Results of the improved method. The left image shows the subsamples obtained, while the right one shows the final result}}{35}{figure.caption.39}%
\contentsline {subfigure}{\numberline {(a)}{\ignorespaces {Subsampling using the improved method. Notice how there are no solid cells outside of the terrain}}}{35}{figure.caption.39}%
\contentsline {subfigure}{\numberline {(b)}{\ignorespaces {Low-resolution decomposition using the improved method. The walls are not perfect, but they approximate the shape of the terrain, unlike the results generated using furthest point sampling }}}{35}{figure.caption.39}%
