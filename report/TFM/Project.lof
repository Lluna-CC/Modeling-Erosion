\contentsline {subfigure}{\numberline {(b)}{\ignorespaces {Low-resolution decomposition using the improved method. The walls are not perfect, but they approximate the shape of the terrain, unlike the results generated using furthest point sampling }}}{36}{figure.caption.40}%
